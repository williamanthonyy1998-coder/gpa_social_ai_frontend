# Local development
VITE_API_URL=http://localhost:4000/api/v1

# Production (Vercel): prefer same-origin so the session cookie is first-party.
# vercel.json rewrites /api/* to the Express backend.
# VITE_API_URL=/api/v1
#
# Cross-origin alternative (requires backend COOKIE_SAME_SITE=none + COOKIE_SECURE=true):
# VITE_API_URL=https://gpa-social-ai-backend.vercel.app/api/v1
